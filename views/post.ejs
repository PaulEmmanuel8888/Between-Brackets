<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../views/partials/head.ejs') %>
  </head>
  <body>
    <%- include('../views/partials/header.ejs') %>

    <div class="container post-container">
      <h1 class="post-heading"><%= post.title %></h1>
      <div class="post-content">
        <div class="post-desc"><%= post.short_desc%></div>
        <div class="post-img-div">
          <img src="<%= post.img_url %>" alt="" />
          <div class="post-details">
            <div class="group">
              <p><span>Written by</span></p>
              <p><%= post.author %></p>
            </div>
            <div class="group">
              <p><span>Published on</span></p>
              <p><%= post.publish_date %></p>
            </div>
          </div>
        </div>
        <div class="main-post-content"><%- post.content %></div>
        <div class="others">
          <p>Want to check out other posts like this?</p>
          <p>
            Check out
            <a href="/category/<%= post.slug %>"
              ><span class="post-tag">#<%= post.category %></span></a
            >
          </p>
        </div>
      </div>
    </div>
    <%- include('../views/partials/footer.ejs') %>
  </body>
</html>
